{
  // One typecheck for the whole monorepo. Workspace packages export TypeScript
  // source directly (see DECISIONS.md D-003), so there is no library build step.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["hachure/*/src", "uplift/*/src", "uplift/spreads", "*.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
